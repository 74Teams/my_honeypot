# Copy thành .env rồi sửa. Mọi biến đều tuỳ chọn — không đặt thì dùng mặc định trong config.py.

# Thư mục chứa DB, log, host key (mặc định: <repo>/data)
# HONEYPY_DATA_DIR=/var/lib/honeypy

HONEYPY_BIND_ADDRESS=0.0.0.0

# SSH honeypot
HONEYPY_SSH_PORT=2222
# HONEYPY_SSH_BANNER=SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13
# HONEYPY_SSH_PROMPT=corporate-jumpbox2$

# HTTP honeypot
# 8080 là mặc định cho VM Ubuntu sạch (kiểu B, NAT 80 → 8080).
# Trên máy T-Pot (192.168.62.130) cổng 8080 đã bị container wordpot của T-Pot chiếm
# → trong .env của máy đó đặt HONEYPY_HTTP_PORT=8081.
HONEYPY_HTTP_PORT=8080
HONEYPY_HTTP_USERNAME=admin
HONEYPY_HTTP_PASSWORD=password
